# Database Settings (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/insurance_claims
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insurance_claims

# LLM Providers (Configure at least one)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Default Model Configuration
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# AWS Deployment Configuration (Production)
AWS_REGION=us-east-1
AWS_S3_CLAIM_BUCKET=insurance-claims-vault-dev
